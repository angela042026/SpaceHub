APP_NAME=SpaceHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de dados MySQL. Criar a base "spacehub" antes de correr as migrations.
# Os testes ignoram estes valores: o phpunit.xml força SQLite em memória.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spacehub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Laravel Reverb — servidor de websockets do chat e do mapa em tempo real.
# Em local os três valores abaixo podem ser quaisquer um, desde que o
# servidor (php artisan reverb:start) e o frontend usem os mesmos.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Lidos pelo Vite a partir dos valores acima — não editar à mão.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Só é ativado quando o utilizador aceita cookies opcionais no banner da landing.
# Deixe vazio para não carregar nenhum script de analytics.
VITE_GA_MEASUREMENT_ID=

# Login com Google. Credenciais criadas na Google Cloud Console, em
# "APIs e serviços" > "Credenciais" > "ID de cliente OAuth" (tipo: aplicação web).
# O URI de redirecionamento tem de estar registado lá tal e qual como está aqui.
# Sem estes valores o resto da aplicação funciona; só o botão "Entrar com Google" falha.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Regras de reservas e limites do dashboard (ver config/reservas.php).
# Comentadas porque os valores por omissão já são os usados em produção
# — só descomentar para ajustar.
# RESERVAS_TOLERANCIA_CHECKIN_MINUTOS=30
# DASHBOARD_TOP_RANKING=5
# DASHBOARD_ATIVIDADE_RECENTE=8
